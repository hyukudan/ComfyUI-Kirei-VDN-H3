      "model_role": "hybrid_b30_49_sage_larry",
      "expects_vdn_runtime": false,
      "lora_strength": 0.6,
      "external_requirements": ["hybrid_b30_49", "sage_attention", "larry_v4_strength_0.6"],
      "notes": "Records the locally observed workflow that looked good: hybrid b30-49 + SageAttention + Larry 0.6 + Euler/beta/6. It is a visual reference, not the canonical Larry or OpenVDN benchmark."
    }
