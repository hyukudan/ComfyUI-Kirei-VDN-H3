{
  "schema_version": 5,
  "rules": {
    "warmup_runs": 1,
    "measured_runs": 5,
    "summary_statistic": "median",
    "primary_metric": "sampler_seconds",
    "secondary_metrics": ["end_to_end_seconds", "peak_vram_bytes"],
    "product_comparison": "same output objective using each model's intended quality recipe",
    "technical_comparison": "same geometry, NFE, sampler, scheduler, denoise, prompt and VDN recipe",
    "quality_gate_required_for_product_speed_claim": true,
    "canonical_vdn_sampler": "euler",
    "canonical_vdn_scheduler": "simple",
    "canonical_vdn_denoise": 1.0,
    "forbidden_vdn_sampler_for_release_recipe": "res_multistep"
  },
  "recipes": {
    "larry_turbo_v4_quality8": {
      "label": "Larry MiniMax-H3 Turbo v4 quality control",
      "steps": 8,
      "sampler_name": "euler",
      "scheduler_name": "simple",
      "denoise": 1.0,
      "video_shift": 12.0,
      "audio_shift": 3.0,
      "scheduler_family": "minimax_h3_flow_v12_a3",
      "model_role": "dense_or_pruned_base_plus_larry_v4",
      "expects_vdn_runtime": false,
      "lora_strength": 1.0,
      "required_adapters": ["larry_v4_external"],
      "notes": "Larry v4 supports 4-8 steps and recommends simple; 6-8 improves detail/motion over the 4-step minimum. The canonical quality control uses stock Euler + simple + 8 steps + strength 1.0 on recent ComfyUI."
    },
    "vdn_stage_dmd_8": {
      "label": "OpenVDN Stage-DMD release",
      "steps": 8,
      "sampler_name": "euler",
      "scheduler_name": "simple",
      "denoise": 1.0,
      "video_shift": 12.0,
      "audio_shift": 3.0,
      "scheduler_family": "minimax_h3_flow_v12_a3",
      "model_role": "stage-dmd-step-250",
      "expects_vdn_runtime": true,
      "runtime_turbo_num_steps": 8,
      "required_adapters": ["default", "turbo"],
      "required_adapter_strength": 1.0,
      "notes": "Canonical OpenVDN few-step trajectory: Euler flow integration, simple MiniMax-H3 sigma grid, 8 NFE, denoise 1.0, shifts 12/3, default + Stage-DMD turbo together. res_multistep is not valid for this recipe."
    },
    "vdn_stage_b_50": {
      "label": "OpenVDN Stage-B teacher/reference",
      "steps": 50,
      "sampler_name": "euler",
      "scheduler_name": "simple",
      "denoise": 1.0,
      "video_shift": 12.0,
      "audio_shift": 3.0,
      "scheduler_family": "minimax_h3_flow_v12_a3",
      "model_role": "stage-b-step-2000",
      "expects_vdn_runtime": true,
      "required_adapters": ["default"],
      "required_adapter_strength": 1.0,
      "notes": "Port-fidelity reference. Turbo disabled. Uses the same Euler/simple H3 trajectory as OpenVDN, at 50 NFE."
    },
    "native_standard_20": {
      "label": "Native MiniMax-H3 base reference",
      "steps": 20,
      "sampler_name": "res_multistep",
      "scheduler_name": "simple",
      "denoise": 1.0,
      "video_shift": 12.0,
      "audio_shift": 3.0,
      "scheduler_family": "minimax_h3_base_reference",
      "model_role": "dense_base_no_lora",
      "expects_vdn_runtime": false,
      "required_adapters": [],
      "notes": "Base-model reference only. res_multistep belongs here, not on Turbo/VDN few-step recipes."
    },
    "local_visual_reference_6_beta": {
      "label": "Local visually-preferred workflow reference",
      "steps": 6,
      "sampler_name": "euler",
      "scheduler_name": "beta",
      "denoise": 1.0,
      "video_shift": 12.0,
